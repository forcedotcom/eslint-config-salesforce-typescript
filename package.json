{
  "name": "eslint-config-salesforce-typescript",
  "version": "7.0.0",
  "description": "The eslint flat config for Salesforce typescript projects",
  "keywords": [
    "Salesforce",
    "eslint",
    "typescript"
  ],
  "author": "Salesforce",
  "homepage": "https://github.com/forcedotcom/eslint-config-salesforce-typescript#readme",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs"
  ],
  "repository": "forcedotcom/eslint-config-salesforce-typescript",
  "bugs": {
    "url": "https://github.com/forcedotcom/eslint-config-salesforce-typescript/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "echo 'no build necessary'",
    "test": "node --input-type=module -e \"import config from './index.mjs'; assert(Array.isArray(config), 'expected array'); console.log('ok:', config.length, 'config entries');\""
  },
  "dependencies": {
    "@eslint/js": "^10.0.0",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.69.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "^6"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "typescript": "^6.0.3"
  }
}
